# DIME backend configuration. Copy to .env (git-ignored). Secrets are referenced by FILE path,
# never inlined, and are never logged. Each signing role uses a different key.
NODE_ENV=development
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
MANIFEST_PATH=../deployments/10143.json
DB_PATH=./data/dime.sqlite

# Signing keys (hex private key files, chmod 600, owned by the service user)
RELAYER_KEY_FILE=/etc/dime/keys/relayer.key
REPORTER_KEY_FILE=/etc/dime/keys/reporter.key
KEEPER_KEY_FILE=/etc/dime/keys/keeper.key
GUARDIAN_KEY_FILE=/etc/dime/keys/guardian.key

# Pricing
PRICE_SOURCES=hyperliquid,binance,coinbase,okx,bybit,kraken   # or "mock" for local tests only
REDUNDANT_SOURCES=hyperliquid,binance   # these run REDUNDANCY concurrent connections each
REDUNDANCY=2
FEED_ALLOWED_ORIGINS=https://dime.rndm.io,http://localhost:3000,http://localhost:3210
PRICING_PORT=8710
PRICING_URL=ws://127.0.0.1:8710/internal
MAX_SOURCE_AGE_MS=2000
MAX_DISAGREEMENT_BPS=15
MIN_SOURCES=2

# API
API_PORT=8720
API_HOST=127.0.0.1
CORS_ORIGINS=https://dime.rndm.io,http://localhost:3000
AUTH_MODE=privy          # privy | none (none is refused when NODE_ENV=production)
PRIVY_APP_ID=
MAX_QUEUE_PER_BUCKET=100
RATE_LIMIT_PER_MIN=60

# Keeper / watchdog
KEEPER_INTERVAL_MS=1000
WATCHDOG_INTERVAL_MS=2000
WATCHDOG_STALE_HOLD_MS=10000
