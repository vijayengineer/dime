# "demo" uses deterministic, clearly-labelled fixtures. "live" talks to real services
# and shows error states when they fail — it never falls back to demo data.
NEXT_PUBLIC_APP_MODE=demo
# Optional (demo): real BTC market data from the DIME pricing service's public /feed.
# Trading stays simulated. If the feed drops, the UI shows an error — it never switches to synthetic prices.
# NEXT_PUBLIC_PRICE_FEED_URL=wss://api-dime.rndm.io/feed   (local: ws://127.0.0.1:8710/feed)

# --- live mode only ---
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_API_URL=            # e.g. https://api-dime.rndm.io
NEXT_PUBLIC_STREAM_URL=         # e.g. wss://api-dime.rndm.io/v1/stream
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
NEXT_PUBLIC_VAULT_ADDRESS=
# Must be the canonical USDC for the selected network. The app reads decimals()/symbol()
# on-chain at start-up and blocks trading if they disagree with the values below.
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_USDC_DECIMALS=6
