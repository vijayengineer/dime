# /etc/dime/backend.env — phase 1 (feed only, no chain, no keys). Not secret.
NODE_ENV=production
LOG_LEVEL=info
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
PRICING_PORT=8710
PRICING_HOST=127.0.0.1
PRICE_SOURCES=hyperliquid,binance,coinbase,okx,bybit,kraken
