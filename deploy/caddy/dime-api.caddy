# DIME backend site for the server's existing Caddy (imported from Cathena's Caddyfile).
# Routes the read-only feed (8710) and the public API (8720). /debug, /internal, /proof, /mock are never exposed.
api-dime.rndm.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@feed path /feed /feed/health /feed/history /feed/metrics /feed/audit /feed/audit/*
	handle @feed {
		reverse_proxy 127.0.0.1:8710
	}
	# API + WebSocket stream (/v1/stream). Admin/internal paths do not exist on the public API.
	handle /v1/* {
		reverse_proxy 127.0.0.1:8720
	}
	handle /health {
		reverse_proxy 127.0.0.1:8720
	}
	handle {
		respond "Not found" 404
	}
}
